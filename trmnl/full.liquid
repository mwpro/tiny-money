<script src="https://usetrmnl.com/js/latest/plugins.js"></script>
<script src="https://trmnl.com/js/highcharts/12.3.0/highcharts.js"></script>
<script src="https://trmnl.com/js/highcharts/12.3.0/pattern-fill.js"></script>

<div class="layout layout--col gap--space-between">

  <!-- Gauges -->
  <div class="grid">
    <div class="row">
      <div class="grid">
        <div class="item col--span-2">
          <div class="meta"></div>
          <div class="content">
            <span class="value value--large value--tnums">{{ budgetLeft | number_to_currency: 'zł' }}</span>
            <span class="label">Pozostały budżet z {{ budgetAmount | number_to_currency: 'zł' }}</span>
          </div>
        </div>
        <div class="item col--span-1">
          <div class="meta"></div>
          <div class="content">
            <span class="value value--small value--tnums">{{ incomesTotal | number_to_currency: 'zł' }}</span>
            <span class="label">Przychody</span>
          </div>
        </div>
        <div class="item col--span-1">
          <div class="meta"></div>
          <div class="content">
            <span class="value value--small value--tnums">{{ expensesTotal | number_to_currency: 'zł' }}</span>
            <span class="label">Wydatki</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="border--h-5 w--full"></div>

  <!-- Daily spending chart -->
  <div class="w--full">
    <span class="label">Wydatki dzienne</span>
    <div id="daily-chart" class="w--full"></div>
    <script>
      document.addEventListener("DOMContentLoaded", function() {
        var year = parseInt('{{ 'now' | date: '%Y' }}');
        var month = parseInt('{{ 'now' | date: '%m' }}');
        var today = parseInt('{{ 'now' | date: '%d' }}');
        var daysInMonth = new Date(year, month, 0).getDate();

        var expenseMap = {};
        var budgetMap = {};
        {% for e in dailyExpenses %}
        expenseMap[{{ e.day }}] = {{ e.amount }};
        budgetMap[{{ e.day }}] = {{ e.budgetLeft }};
        {% endfor %}

        var chartData = [];
        var budgetData = [];
        var chartCategories = [];
        for (var d = 1; d <= daysInMonth; d++) {
          chartCategories.push(d);
          chartData.push(d <= today ? (expenseMap[d] || 0) : null);
          budgetData.push(d <= today && budgetMap[d] !== undefined ? budgetMap[d] : null);
        }

        Highcharts.chart('daily-chart', {
          chart: {
            height: 185,
            animation: false,
            spacing: [5, 0, 5, 0],
            margin: [30, 0, 20, 0]
          },
          title: { text: null },
          plotOptions: {
            series: {
              animation: false,
              enableMouseTracking: false,
              states: { hover: { enabled: false } }
            }
          },
          series: [
            {
              type: 'column',
              data: chartData,
              yAxis: 0,
              borderWidth: 0,
              pointPadding: 0.05,
              groupPadding: 0.02,
              color: '#000000',
              dataLabels: {
                enabled: true,
                crop: false,
                overflow: 'allow',
                formatter: function() {
                  if (!this.y) return null;
                  return this.y >= 1000
                    ? (Math.round(this.y / 100) / 10) + 'k'
                    : Math.round(this.y);
                },
                style: {
                  fontSize: '8px',
                  fontWeight: 'normal',
                  textOutline: 'none',
                  color: '#000000'
                },
                rotation: -90,
                align: 'left',
                verticalAlign: 'bottom',
                y: -2
              }
            },
            {
              type: 'spline',
              data: budgetData,
              yAxis: 1,
              lineWidth: 4,
              color: {
                pattern: {
                  image: 'https://trmnl.com/images/grayscale/gray-1.png',
                  width: 12,
                  height: 12
                }
              },
              marker: { enabled: false },
              dataLabels: { enabled: false }
            }
          ],
          tooltip: { enabled: false },
          legend: { enabled: false },
          yAxis: [
            {
              labels: { enabled: true },
              gridLineWidth: 0,
              tickAmount: 5,
              title: { text: null },
              min: 0
            },
            {
              gridLineWidth: 0,
              tickAmount: 5,
              title: { text: null },
              opposite: true,
              min: 0
            }
          ],
          xAxis: {
            categories: chartCategories,
            labels: {
              style: { fontSize: '10px', color: '#000000' }
            },
            lineWidth: 0,
            gridLineWidth: 1,
            gridLineColor: '#000000',
            gridLineDashStyle: 'dot',
            tickWidth: 0,
            title: { text: null }
          },
          credits: { enabled: false }
        });
      });
    </script>
  </div>

  <div class="border--h-5 w--full"></div>

  <!-- Pozostało / Przekroczone -->
  <div class="columns">

    <div class="flex flex--col stretch-x" style="align-items: flex-start; align-self: flex-start;">
      <span class="label">Budżet - Największa nadwyżka</span>
      {% for cat in topRemainingBudgetCategories %}
      <div class="item">
        <div class="content" style="justify-content: flex-start; flex: 1; min-width: 0;">
          <span class="description">{{ cat.categoryName }}{% if cat.subcategoryName != '' %} · {{ cat.subcategoryName }}{% endif %}</span>
        </div>
        <span class="description" style="white-space: nowrap; flex-shrink: 0; padding-left: var(--gap-small);">+{{ cat.amountLeft | number_to_currency: 'zł' }}</span>
      </div>
      {% else %}
      <span class="description">Brak kategorii z pozostałym budżetem</span>
      {% endfor %}
    </div>

    <div class="flex flex--col stretch-x" style="align-items: flex-start; align-self: flex-start; border-left: 1px solid var(--black); padding-left: var(--gap);">
      <span class="label">Budżet - Największe przekroczenie</span>
      {% for cat in topOverspentBudgetCategories %}
      <div class="item">
        <div class="content" style="justify-content: flex-start; flex: 1; min-width: 0;">
          <span class="description">{{ cat.categoryName }}{% if cat.subcategoryName != '' %} · {{ cat.subcategoryName }}{% endif %}</span>
        </div>
        <span class="description" style="white-space: nowrap; flex-shrink: 0; padding-left: var(--gap-small);">{{ cat.amountLeft | number_to_currency: 'zł' }}</span>
      </div>
      {% else %}
      <span class="description">Brak przekroczonych kategorii</span>
      {% endfor %}
    </div>

  </div>

</div>

<div class="title_bar">
  <img class="image" src="https://money.mwpro.pl/favicon.svg" />
  <span class="title">tiny-money</span>
  <span class="instance">{{ 'now' | l_date: '%b %Y', trmnl.user.locale }}{% if unverifiedCount > 0 %} &nbsp;·&nbsp; ⚠ {{ unverifiedCount }} niezweryfikowanych{% endif %}</span>
</div>
