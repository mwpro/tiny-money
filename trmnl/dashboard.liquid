<link rel="stylesheet" href="https://usetrmnl.com/css/latest/plugins.css">
<script src="https://usetrmnl.com/js/latest/plugins.js"></script>

<div class="screen">
  <div class="view view--full">
    <div class="layout layout--col layout--stretch-y">

      <!-- Header -->
      <div class="flex flex--row" style="justify-content: space-between; align-items: center; padding-bottom: 6px; border-bottom: 2px solid #000; width: 100%;">
        <span style="font-size: 18px; font-weight: bold;">tiny-money</span>
        <span style="font-size: 14px;">{{ 'now' | date: '%B %Y' }}</span>
        {% if unverifiedCount > 0 %}
          <span style="font-size: 14px; font-weight: bold;">⚠ {{ unverifiedCount }} unverified</span>
        {% else %}
          <span></span>
        {% endif %}
      </div>

      <!-- Summary gauges -->
      <div class="flex flex--row" style="width: 100%; gap: 8px; padding: 6px 0;">
        <div style="flex: 1; display: flex; flex-direction: column;">
          <span class="label">Przychody</span>
          <span style="font-size: 22px; font-weight: bold; white-space: nowrap;">{{ incomesTotal | number_to_currency: 'zł' }}</span>
        </div>
        <div style="flex: 1; display: flex; flex-direction: column;">
          <span class="label">Wydatki</span>
          <span style="font-size: 22px; font-weight: bold; white-space: nowrap;">{{ expensesTotal | number_to_currency: 'zł' }}</span>
        </div>
        <div style="flex: 1; display: flex; flex-direction: column;">
          <span class="label">Pozostały budżet</span>
          <span style="font-size: 22px; font-weight: bold; white-space: nowrap;">{{ budgetLeft | number_to_currency: 'zł' }}</span>
          <span class="label">of {{ budgetAmount | number_to_currency: 'zł' }}</span>
        </div>
      </div>

      <!-- Daily spending bar chart -->
      <div style="border-top: 1px solid #ccc; padding: 6px 0; width: 100%;">
        <span class="label" style="display: block; margin-bottom: 2px;">Daily spending</span>
        {% assign max_expense = 0 %}
        {% for e in dailyExpenses %}
          {% if e.amount > max_expense %}{% assign max_expense = e.amount %}{% endif %}
        {% endfor %}
        <div style="font-family: monospace; font-size: 20px; line-height: 1; width: 100%; word-break: break-all;">{% for e in dailyExpenses %}{% if max_expense > 0 %}{% assign bar_pct = e.amount | times: 8 | divided_by: max_expense | round %}{% else %}{% assign bar_pct = 0 %}{% endif %}{% if e.amount == 0 or bar_pct == 0 %}▁{% elsif bar_pct == 1 %}▂{% elsif bar_pct == 2 %}▃{% elsif bar_pct == 3 %}▄{% elsif bar_pct == 4 %}▅{% elsif bar_pct == 5 %}▆{% elsif bar_pct == 6 %}▇{% else %}█{% endif %}{% endfor %}</div>
      </div>

      <!-- Bottom: overspent / remaining -->
      <div class="flex flex--row" style="border-top: 1px solid #ccc; padding-top: 6px; width: 100%; gap: 16px; flex: 1;">

        <!-- Overspent -->
        <div style="flex: 1; display: flex; flex-direction: column; overflow: hidden;">
          <span style="font-size: 13px; font-weight: bold; margin-bottom: 4px;">⚠ Overspent</span>
          {% if topOverspentBudgetCategories.size > 0 %}
            {% for cat in topOverspentBudgetCategories %}
              <div class="flex flex--row" style="justify-content: space-between; align-items: baseline; gap: 4px;">
                <span style="font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; flex: 1;">{{ cat.categoryName }}{% if cat.subcategoryName != '' %} · {{ cat.subcategoryName }}{% endif %}</span>
                <span style="font-size: 12px; font-weight: bold; white-space: nowrap;">{{ cat.amountLeft | number_to_currency: 'zł' }}</span>
              </div>
            {% endfor %}
          {% else %}
            <span style="font-size: 12px; color: #888;">No overspent categories</span>
          {% endif %}
        </div>

        <div style="width: 1px; background: #ccc;"></div>

        <!-- Remaining -->
        <div style="flex: 1; display: flex; flex-direction: column; overflow: hidden;">
          <span style="font-size: 13px; font-weight: bold; margin-bottom: 4px;">✓ Remaining</span>
          {% if topRemainingBudgetCategories.size > 0 %}
            {% for cat in topRemainingBudgetCategories %}
              <div class="flex flex--row" style="justify-content: space-between; align-items: baseline; gap: 4px;">
                <span style="font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; flex: 1;">{{ cat.categoryName }}{% if cat.subcategoryName != '' %} · {{ cat.subcategoryName }}{% endif %}</span>
                <span style="font-size: 12px; white-space: nowrap;">+{{ cat.amountLeft | number_to_currency: 'zł' }}</span>
              </div>
            {% endfor %}
          {% else %}
            <span style="font-size: 12px; color: #888;">No remaining categories</span>
          {% endif %}
        </div>

      </div>

    </div>
  </div>
</div>
